---
import { Image } from "astro:assets";
import imagen1 from './../assets/images/machupicchu.png';
---

<div class="hero-container">
  <Image src={imagen1} alt="Hero background" class="hero-bg" />
  <div class="hero-overlay"></div>
  
  <div class="hero-content">
    <h1 class="title">MURO DE <br /> LA EXCELENCIA</h1>
    <p class="subtitle">El eco de nuestros viajeros</p>
    
    <div class="divider">
      <div class="line-left"></div>
      <div class="icon-circle">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-quote"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 5a2 2 0 0 1 2 2v6c0 3.13 -1.65 5.193 -4.757 5.97a1 1 0 1 1 -.486 -1.94c2.227 -.557 3.243 -1.827 3.243 -4.03v-1h-3a2 2 0 0 1 -1.995 -1.85l-.005 -.15v-3a2 2 0 0 1 2 -2z" /><path d="M18 5a2 2 0 0 1 2 2v6c0 3.13 -1.65 5.193 -4.757 5.97a1 1 0 1 1 -.486 -1.94c2.227 -.557 3.243 -1.827 3.243 -4.03v-1h-3a2 2 0 0 1 -1.995 -1.85l-.005 -.15v-3a2 2 0 0 1 2 -2z" /></svg>
      </div>
      <div class="line-right"></div>
    </div> 

    <p class="description">
      Durante 50 años hemos tenido el privilegio de acompañar<br class="desktop-only" /> 
      a miles de viajeros de todo el mundo en su descubrimiento del Perú.
    </p>

    <div class="badge">
      <span>1976 – 2026</span>
      <span class="separator">|</span>
      <span>50 AÑOS ACOMPAÑANDO VIAJEROS</span>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;1,400&family=Plus+Jakarta+Sans:wght@300;400;600&display=swap');

  .hero-container {
    position: relative;
    width: 100%;
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  background: linear-gradient(to right, #000000, #00000032);
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    right: 300px;
    color: #ffffff;
    text-align: center;
    display: flex;
    flex-direction: column;
    
    align-items: center;
  }

  .title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 2px;
    margin: 0;
    text-transform: uppercase;
  }

  .subtitle {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: clamp(24px, 3.5vw, 42px);
    color: #d4a755;
    margin: 15px 0 25px 0;
    font-weight: 400;
  }

  .divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 320px;
    margin-bottom: 30px;
  }

  .line-right {
    flex: 2;
    height: 4px;
    background: linear-gradient(90deg, #b89146, transparent);
  }

   .line-left {
    flex: 2;
    height: 4px;
    background: linear-gradient(90deg, transparent, #b89146);
  }

  .icon-circle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid #b89146;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d4a755;
    font-size: 22px;
    margin: 0 15px;
    background-color: rgba(0, 0, 0, 0.3);
  }

  .description {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(15px, 1.8vw, 19px);
    font-weight: 300;
    line-height: 1.6;
    color: #e0e0e0;
    margin: 0 0 35px 0;
  }

  .badge {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(13px, 1.5vw, 16px);
    font-weight: 600;
    color: #d4a755;
    letter-spacing: 1.5px;
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .separator {
    color: #b89146;
    font-weight: 300;
  }

  @media (max-width: 600px) {
    .desktop-only {
      display: none;
    }
  }


  @media (max-width: 1200px) {
    .hero-content {
        right: 180px;
    }

  }

    @media (max-width: 955) {
    .hero-content {
        right: 100px;
    }

  }

  
    @media (max-width: 803) {
    .hero-content {
        right: 0px;
        padding: 30px;
    }

  }
</style>