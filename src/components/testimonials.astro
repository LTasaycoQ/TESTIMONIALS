---

<section class="testimonials-section" aria-labelledby="testimonials-title">
  <h2 id="testimonials-title" style="text-align: center;" class="section-title">Nuestra mayor recompensa</h2>

  <div class="divider" aria-hidden="true">
    <span class="line-left"></span>
    <span class="icon-circle">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M8.243 7.34l-6.38 .925a1 1 0 0 0-.44 1.684l4.622 4.499-1.09 6.355a1 1 0 0 0 1.464.944l5.706-3 5.693 3a1 1 0 0 0 1.352-1.1l-1.091-6.355 4.624-4.5a1 1 0 0 0-.633-1.62l-6.38-.926-2.852-5.78a1 1 0 0 0-1.794 0L8.243 7.34z"/>
      </svg>
    </span>
    <span class="line-right"></span>
  </div>

  <p class="section-subtitle">
    Testimonios reales que reflejan momentos, emociones y recuerdos <br> que permanecen mucho tiempo después de finalizar el viaje.
  </p>

  <div class="filters-container" role="tablist" aria-label="Filtrar testimonios por categoría">
    <button class="filter-btn active" data-categoria="todos" role="tab" aria-selected="true">
      TODOS
    </button>
    {
      categorias.map((cat) => (
        <button class="filter-btn" data-categoria={cat} role="tab" aria-selected="false">
          {cat.toUpperCase()}
        </button>
      ))
    }
  </div>

  <div class="testimonials-grid" id="testimonialsGrid">
    {
      testimonios.map((item, index) => (
        <article 
          class="testimonial-card" 
          data-categoria={item.categoria}
          data-index={index}
          style={index >= 8 ? 'display: none;' : ''}
        >
          <div class="card-header">
            <svg class="quote-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 5a2 2 0 0 1 2 2v6c0 3.13-1.65 5.193-4.757 5.97a1 1 0 1 1-.486-1.94c2.227-.557 3.243-1.827 3.243-4.03v-1h-3a2 2 0 0 1-1.995-1.85l-.005-.15v-3a2 2 0 0 1 2-2z"/>
              <path d="M18 5a2 2 0 0 1 2 2v6c0 3.13-1.65 5.193-4.757 5.97a1 1 0 1 1-.486-1.94c2.227-.557 3.243-1.827 3.243-4.03v-1h-3a2 2 0 0 1-1.995-1.85l-.005-.15v-3a2 2 0 0 1 2-2z"/>
            </svg>
            <div class="stars" aria-label="5 estrelas">
              {[...Array(5)].map(() => (
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8.243 7.34l-6.38 .925a1 1 0 0 0-.44 1.684l4.622 4.499-1.09 6.355a1 1 0 0 0 1.464.944l5.706-3 5.693 3a1 1 0 0 0 1.352-1.1l-1.091-6.355 4.624-4.5a1 1 0 0 0-.633-1.62l-6.38-.926-2.852-5.78a1 1 0 0 0-1.794 0L8.243 7.34z"/>
                </svg>
              ))}
            </div>
          </div>
          {/* <span class="categoria-badge">{item.categoria}</span> */}
          <p class="testimonial-text">{item.comentario}</p>
        </article>
      ))
    }
  </div>

  <div class="btn-container">
    <button 
      id="showMoreBtn" 
      class="btn-show-more"
      data-visible="false"
      aria-expanded="false"
      aria-controls="testimonialsGrid"
    >
VER MENOS TESTIMONIOS    </button>
  </div>

  <br>
  <br>
  <br>
</section>

<style>

  .testimonials-section {
    margin-top: 70px;
    background-color: #F4F4F0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    font-family: 'Poppins', sans-serif;
  }

  .section-title {
    font-weight: 400;
    text-transform: uppercase;
    margin-top: 40px;
    font-family:'Times New Roman', Times, serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: #303030;
    letter-spacing: 1px;
  }

  .divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 320px;
    gap: 20px;
    margin: 0.5rem 0 1rem 0;
  }

  .line-left,
  .line-right {
    flex: 2;
    height: 4px;
  }

  .line-left {
    background: linear-gradient(90deg, transparent, #b89146);
  }

  .line-right {
    background: linear-gradient(90deg, #b89146, transparent);
  }

  .icon-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .icon-circle svg {
    fill: rgb(203, 141, 24);
    width: 24px;
    height: 24px;
  }

  .section-subtitle {
    text-align: center;
    font-weight: 300;
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    color: #2c2c2c;
    line-height: 1.6;
    max-width: 700px;
    margin-bottom: 2rem;
  }

  .filters-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 2.5rem;
    width: 100%;
    max-width: 900px;
  }

  .filter-btn {
    background-color: white;
    border: 2px solid #353f3a;
    color: #394b40;
    padding: 10px 24px;
    border-radius: 50px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    background-color: #404641;
    color: white;
  }

  .filter-btn.active {
    background-color: #0B2314;
    color: white;
    box-shadow: 0 4px 15px rgba(184, 145, 70, 0.3);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: 1500px;
    width: 100%;
    margin-bottom: 2rem;
  }

  .testimonial-card {
    background-color: #ffffff;
    box-shadow: 2px 5px 15px rgba(0, 0, 0, 0.12);
    padding: 1.8rem 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .testimonial-card:hover {
    box-shadow: 2px 10px 30px rgba(0, 0, 0, 0.15);
  }

  .testimonial-card.hidden-by-filter {
    display: none !important;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.3rem;
  }

  .quote-icon {
    fill: #b89146;
    width: 32px;
    height: 32px;
    transform: rotate(180deg);
    flex-shrink: 0;
    opacity: 0.8;
  }

  .stars {
    display: flex;
    gap: 6px;
    color: #b89146;
  }

  .stars svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .categoria-badge {
    display: inline-block;
    background-color: #f0ebe0;
    color: #b89146;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 14px;
    border-radius: 50px;
    align-self: flex-start;
    margin-top: 0.2rem;
  }

  .testimonial-text {
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.6;
    color: #1e1e1e;
    margin: 0;
  }

  .btn-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 0.5rem;
  }

  .btn-show-more {
    background-color: #1e261e;
    color: #ffffff;
    border: none;
    border-radius: 50px;
    padding: 18px 48px;
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.15s ease, box-shadow 0.3s ease;
    text-transform: uppercase;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
  }

  .btn-show-more:hover {
    background-color: #2f3d2f;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  }

  .btn-show-more:active {
    transform: scale(0.97);
  }

  .btn-show-more.hidden {
    display: none;
  }

  /* ============================
     RESPONSIVIDAD
     ============================ */

  @media (max-width: 1200px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }
  }

  @media (max-width: 900px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .filters-container {
      gap: 10px;
    }

    .filter-btn {
      padding: 8px 18px;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 600px) {
    .testimonials-section {
      margin-top: 40px;
    }

    .testimonials-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .testimonial-card {
      padding: 1.2rem 1rem;
    }

    .section-title {
      font-size: 1.8rem;
      margin-top: 20px;
    }

    .btn-show-more {
      padding: 14px 32px;
      font-size: 0.85rem;
      width: 100%;
      max-width: 320px;
    }

    .section-subtitle br {
      display: none;
    }

    .filters-container {
      gap: 8px;
    }

    .filter-btn {
      padding: 6px 14px;
      font-size: 0.7rem;
    }
  }

  @media (max-width: 400px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .stars {
      align-self: flex-start;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('testimonialsGrid');
    const cards = grid.querySelectorAll('.testimonial-card');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const showMoreBtn = document.getElementById('showMoreBtn');

    let currentCategory = 'todos';
    let isExpanded = false;

    function filterCards(categoria) {
      currentCategory = categoria;

      filterBtns.forEach(btn => {
        const isActive = btn.dataset.categoria === categoria;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive);
      });

      cards.forEach(card => {
        const cardCategoria = card.dataset.categoria;
        const match = categoria === 'todos' || cardCategoria === categoria;

        if (!match) {
          card.classList.add('hidden-by-filter');
        } else {
          card.classList.remove('hidden-by-filter');
        }
      });

      if (isExpanded) {
        isExpanded = false;
        showMoreBtn.textContent = 'VER MAIS TESTEMUNHOS';
        showMoreBtn.dataset.visible = 'false';
        showMoreBtn.setAttribute('aria-expanded', 'false');
      }

      applyShowMore();
    }

    function applyShowMore() {
      const visibleCards = Array.from(cards).filter(
        card => !card.classList.contains('hidden-by-filter')
      );

      visibleCards.forEach((card, index) => {
        if (index >= 8 && !isExpanded) {
          card.style.display = 'none';
        } else if (index >= 8 && isExpanded) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'flex';
        }
      });

      if (visibleCards.length <= 8) {
        showMoreBtn.classList.add('hidden');
      } else {
        showMoreBtn.classList.remove('hidden');
      }
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const categoria = btn.dataset.categoria;
        filterCards(categoria);
      });
    });

    showMoreBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;

      const visibleCards = Array.from(cards).filter(
        card => !card.classList.contains('hidden-by-filter')
      );

      visibleCards.forEach((card, index) => {
        if (index >= 8) {
          card.style.display = isExpanded ? 'flex' : 'none';
        }
      });

      showMoreBtn.textContent = isExpanded ? 'VER MENOS TESTEMUNHOS' : 'VER MAIS TESTEMUNHOS';
      showMoreBtn.dataset.visible = isExpanded;
      showMoreBtn.setAttribute('aria-expanded', isExpanded);
    });

    filterCards('todos');
  });
</script>