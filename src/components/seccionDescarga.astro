---
import { Image } from "astro:assets";
import ImagenPDF from "./../assets/images/document/pdf.png";
import ImageWord from "./../assets/images/document/Logo-Microsoft-Word.png";
---

<section class="download-section" aria-labelledby="download-title">
  <div class="download-grid">

    <div class="text-column">
      <span class="badge">LOS TESTIMONIOS COMPLETOS</span>
      <h2 id="download-title" class="main-title">
        Descarga todos nuestros <br> testimonios
      </h2>
      <p class="description">
      Accede a todos los comentarios y testimonios completos de nuestros viajeros en formato PDF y Word.
      </p>
    </div>

    <div class="card-pdf" role="article" aria-label="Descargar testimonios en PDF">
      <div class="card-content">
        <Image 
          src={ImagenPDF} 
          alt="Icono de archivo PDF" 
          width={150} 
          loading="lazy"
          class="pdf-icon"
        />
        <div class="card-text">
          <h3 class="card-title">Muro de la Excelencia</h3>
          <p class="card-subtitle">
           Testimonios completos en formato PDF
          </p>
          <a 
            href="/download/Muro-de-la-Excelencia.pdf" 
            target="_blank" 
            class="btn-download"
            aria-label="Descargar testimonios completos en PDF"
          >
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              width="24" 
              height="24" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2" 
              stroke-linecap="round" 
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
              <path d="M7 11l5 5l5 -5" />
              <path d="M12 4l0 12" />
            </svg>
                DESCARGAR PDF
            </a>
        </div>
      </div>
    </div>

    <div class="card-pdf" role="article" aria-label="Descargar testimonios en PDF">
      <div class="card-content">
        <Image 
          src={ImageWord} 
          alt="Icono de archivo PDF" 
          width={200} 
          loading="lazy"
          class="pdf-icon"
        />
        <div class="card-text">
          <h3 class="card-title">Muro de la Excelencia</h3>
          <p class="card-subtitle">
           Testimonios completos en formato Word
          </p>
          <a 
            href="/download/Muro-de-la-Excelencia.docx" 
            target="_blank" 
            class="btn-download"
            aria-label="Descargar testimonios completos en PDF"
          >
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              width="24" 
              height="24" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2" 
              stroke-linecap="round" 
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
              <path d="M7 11l5 5l5 -5" />
              <path d="M12 4l0 12" />
            </svg>
             DESCARGAR WORD
          </a>
        </div>
      </div>
    </div>

  </div>
 

</section>


<br>
<br>
<br>
<br>

<style>

@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');
  .download-section {
    margin-top: 70px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Poppins', sans-serif;
  }

  .download-grid {
    max-width: 1400px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .text-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .badge {
    font-size: 0.9rem;
    color: rgb(198, 134, 6);
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .main-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
    margin: 0.5rem 0;
    font-family: 'Times New Roman', Times, serif;
    line-height: 1.2;
    color: #1e1e1e;
  }

  .description {
    font-size: 0.95rem;
    color: #3a3a3a;
    line-height: 1.6;
    font-weight: 300;
  }

  .card-pdf {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.10);
    padding: 1.5rem 1.2rem;
  }

  

  .card-content {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pdf-icon {
    max-width: 120px;
    height: auto;
    flex-shrink: 0;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
    min-width: 160px;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1e1e1e;
    margin: 0;
  }

  .card-subtitle {
    font-size: 0.9rem;
    color: #555;
    margin: 0;
    line-height: 1.4;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background-color: #1f281f;
    color: #ffffff;
    text-decoration: none;
    padding: 12px 28px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    transition: background 0.25s ease, transform 0.15s ease;
    border: none;
    cursor: pointer;
    width: fit-content;
    margin-top: 0.5rem;
  }

  .btn-download:hover {
    background-color: #2f3d2f;
  }

  .btn-download:active {
    transform: scale(0.97);
  }

  .btn-download svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .card-placeholder {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.10);
    padding: 2rem 1.5rem;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #aaa;
    font-weight: 300;
    border: 2px dashed #ddd;
  }


  @media (max-width: 1100px) {
    .download-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.8rem;
    }

    .card-placeholder {
      grid-column: span 2;
    }
  }

  @media (max-width: 750px) {
    .download-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .card-placeholder {
      grid-column: span 1;
    }

    .card-content {
      flex-direction: column;
      text-align: center;
    }

    .btn-download {
      width: 100%;
      justify-content: center;
    }

    .text-column {
      text-align: center;
      align-items: center;
    }

    .description br {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .download-section {
      margin-top: 40px;
    }

    .card-pdf {
      padding: 1.2rem 0.8rem;
    }

    .main-title {
      font-size: 1.8rem;
    }

    .pdf-icon {
      max-width: 90px;
    }

    .btn-download {
      font-size: 0.8rem;
      padding: 10px 20px;
    }
  }
</style>