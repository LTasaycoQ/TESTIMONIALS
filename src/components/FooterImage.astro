---
import { Image } from "astro:assets";
import LogoAnos from './../assets/images/logo-50.png';
---

<footer class="footer-bg">
  <div class="footer-overlay"></div>
  <div class="content">
    <Image class="footer-logo" width={300} src={LogoAnos} alt="Logo Anos" />

    <div class="footer-text-group">
      <div class="footer-text-row">
        <div class="footer-text-block">
          <span class="highlight-title" style="text-transform: uppercase;">
            CINCO Cinco décadas, miles <br /> de historias y un solo objetivo 
          </span>
          <h2 class="main-title">LA EXCELENCIA</h2>
        </div>

        <div class="footer-text-block testimonial">
          <span class="testimonial-text">
            Gracias por acompañarnos en esta travesía de 50-Años, lo mejor está por venir. 
          </span>
        </div>
      </div>

      <span class="footer-quote">
       La Excelencia No Es Una Meta, Es Nuestra <br> Forma De Darte La Bienvenida 
      </span>
    </div>
  </div>
</footer>

<style>
  /* ===== RESET ===== */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .footer-bg {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    background-image: linear-gradient(to bottom, rgba(0,0,0,0.7), rgba(0,0,0,0.1)), url('https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1789594416/001_ME7A4181-Cusco_TREK_eqeqth.jpg');
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center 80%;
    position: relative;
  }

  .footer-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 1;
  }

  .content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    gap: 2rem;
    flex-wrap: wrap;
    overflow-x: hidden;
  }

  .footer-logo {
    max-width: 200px;
    height: auto;
    padding: 0 1.5rem 0 0;
    border-right: 1px solid rgb(244, 182, 9);
    flex-shrink: 0;
  }

  .footer-text-group {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex: 1;
    min-width: 200px;
    max-width: 100%;
  }

  .footer-text-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    width: 100%;
    gap: 1.5rem;
  }

  .footer-text-block {
    flex: 1;
    min-width: 200px;
    max-width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 0.5rem;
  }

  .highlight-title {
    color: white;
    font-size: 20px;
    font-family: 'Poppins', sans-serif;
    text-align: center;
    line-height: 1.4;
  }

  .main-title {
    font-size: 62px;
    margin: 0;
    font-weight: 300;
    color: rgb(250, 188, 0);
    font-family: 'Poppins', sans-serif;
    line-height: 1.2;
    word-break: break-word;
  }

  .testimonial-text {
    color: rgb(199, 198, 198);
    font-size: 17px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    text-align: center;
    max-width: 600px;
    line-height: 1.6;
  }

  .footer-quote {
    text-align: center;
    font-style: italic;
    margin-top: 50px;
    font-weight: 500;
    font-size: 30px;
    color: rgb(252, 192, 96);
    font-family: 'Poppins', sans-serif;
    line-height: 1.4;
  }

  /* ===== RESPONSIVE ===== */

  /* Tablets */
  @media (max-width: 1024px) {
    .footer-logo {
      max-width: 180px;
      border-right: none;
      padding: 0 0 1rem 0;
    }

    .content {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 2rem 1.5rem;
      gap: 1rem;
    }

    .main-title {
      font-size: 48px;
    }

    .footer-quote {
      font-size: 26px;
      margin-top: 35px;
    }

    .highlight-title {
      font-size: 18px;
    }

    .testimonial-text {
      font-size: 16px;
      max-width: 500px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .content {
      min-height: auto;
      padding: 2rem 1rem;
    }

    .footer-logo {
      max-width: 150px;
      padding: 0 0 0.5rem 0;
    }

    .footer-text-row {
      flex-direction: column;
      gap: 1rem;
    }

    .footer-text-block {
      min-width: auto;
      padding: 0;
    }

    .main-title {
      font-size: 38px;
    }

    .highlight-title {
      font-size: 16px;
    }

    .testimonial-text {
      font-size: 15px;
      max-width: 100%;
      padding: 0 0.5rem;
    }

    .footer-quote {
      font-size: 22px;
      margin-top: 30px;
    }
  }

  /* Mobile pequeño */
  @media (max-width: 480px) {
    .content {
      padding: 1.5rem 0.75rem;
    }

    .footer-logo {
      max-width: 120px;
    }

    .main-title {
      font-size: 30px;
    }

    .highlight-title {
      font-size: 14px;
    }

    .testimonial-text {
      font-size: 13px;
    }

    .footer-quote {
      font-size: 18px;
      margin-top: 25px;
    }

    .footer-text-row {
      gap: 0.75rem;
    }
  }
</style>