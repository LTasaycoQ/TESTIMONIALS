---
const ImageCollage = [
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691044/d5f73f8c-208e-42fb-84a2-24d047af8a4d_nfdgh0.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691041/e5de5a35-232f-4ac9-8b60-dd9ecaf7e681_wophc7.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691041/ab91ecf4-fa85-4719-a8d4-0cdcf8c6dbf7_nvspxm.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691039/4689bc90-d784-4698-b5fd-90aac2ee858a_wz8ofd.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691031/438088d6-86be-4cff-9666-43fa7183162e_gnuuev.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691030/4d040a9d-6aec-48e7-a6ce-a177571fde26_lrogbj.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691029/936f7705-416e-405d-9a36-49727ce03e78_jyhmj2.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691027/6bd2aeda-bc56-4376-bd34-5eb526c86421_nzfv9d.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691025/36f04c04-caf4-4c8e-acb6-6e9fb5f4f5ac_ioqvkh.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691025/36f04c04-caf4-4c8e-acb6-6e9fb5f4f5ac_ioqvkh.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691025/3d1aaa75-6a4a-48d7-a64b-e531585263e4_fe1b3y.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691023/07dcaaec-7a12-4a6d-b02a-58a7e53c54ee_vxmdfb.png",
  "https://res.cloudinary.com/dlgeap8h0/image/upload/v1792691020/0c20987b-74b9-4e0f-96aa-bed36334f71c_ak5mq5.png",
];

const loopImages = [...ImageCollage, ...ImageCollage];
---

<section class="gallery-section">
  <div class="gallery-header">
   
  </div>

  <div class="infinite-carousel">
    <div style="position:relative;">
        <div class="degradado" style="position :absolute; width: 100%; height: 100%;z-index: 999;">

        </div>
        <div class="infinite-track" style="z-index: 10;display:flex; gap: 29px;">
        {loopImages.map((src, index) => (
            <div>
            <img src={src} style="box-shadow: rgba(67, 71, 85, 0.27) 0px 0px 0.25em, rgba(90, 125, 188, 0.05) 0px 0.25em 1em;border-radius: 3px; width:380px; object-fit: cover;  height: 390px;"
            alt={`Imagen ${(index % ImageCollage.length) + 1}`}
                loading={index < 2 ? 'eager' : 'lazy'}>
            </div>
        ))}
        </div>
    </div>
  </div>
</section>

<style>
  .gallery-section {
    width: min(1100px, calc(100% - 32px));
    margin: 48px auto 0;
    padding: 20px 0 0;
  }


  .gallery-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .section-label {
    display: inline-block;
    color: #b89146;
    font-size: 0.8rem;
    letter-spacing: 0.18rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .gallery-header h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    color: #1d1d1d;
    font-family: 'Georgia', 'Times New Roman', serif;
  }

  .infinite-carousel {
    overflow: hidden;
 }

  .infinite-track {
    display: flex;
    width: max-content;
    animation: scroll 20s linear infinite;
  }

  .infinite-carousel:hover .infinite-track {
  }

  .infinite-slide {
    flex: 0 0 auto;
    width: 320px;
    height: 220px;
    margin-right: 12px;
  }


  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-20%);
    }
  }

  @media (max-width: 640px) {
    .infinite-slide {
      width: 240px;
      height: 160px;
    }

    .infinite-track {
      animation-duration: 14s;
    }
  }
</style>
